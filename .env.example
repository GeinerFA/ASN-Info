PORT=3000
NODE_ENV=development
# URL pública del sitio (sin / final). Se usa en canonical, Open Graph y sitemap.
SITE_URL=http://localhost:3000
# Cambiar por una cadena larga y aleatoria en producción
SESSION_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria

# Correo saliente (formulario de la Contraloría de Servicios). Lo da el área de TI de la CCSS.
# Sin SMTP_HOST, en desarrollo el mensaje se muestra en la consola; en producción NO se envía.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente (opcional; por defecto SMTP_USER) y destino (opcional; por defecto cs_asn@ccss.sa.cr)
SMTP_FROM=
CONTRALORIA_CORREO=
