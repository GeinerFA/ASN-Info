<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 
      promoteServerVars: Pasa a Node el estado del SSL (HTTPS) y las IPs reales sin romper las reglas de IIS.
      enableXFF: Habilita el reenvío de la IP original del cliente (X-Forwarded-For) para el limitador de login.
    -->
    <iisnode nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
             node_env="production"
             loggingEnabled="true"
             logDirectory="iisnode"
             devErrorsEnabled="true"
             enableXFF="true"
             promoteServerVars="HTTPS,HTTP_X_FORWARDED_PROTO"
             watchedFiles="web.config;*.js;.env" />

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- No tocar peticiones al inspector de iisnode -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Todo el tráfico restante pasa a server.js -->
        <rule name="DynamicContent">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="data" />
          <add segment="datos" />
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".githooks" />
          <add segment="db" />
          <add segment="lib" />
          <add segment="middleware" />
          <add segment="routes" />
          <add segment="scripts" />
          <add segment="views" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>