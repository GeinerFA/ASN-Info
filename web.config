<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Ruta entre comillas para evitar errores de espacios -->
    <iisnode nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
             node_env="production"
             loggingEnabled="true"
             logDirectory="iisnode"
             devErrorsEnabled="true"
             watchedFiles="web.config;*.js" />

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Ignorar inspector de iisnode -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Permitir acceso directo a la carpeta public (CSS, JS, imágenes) -->
        <rule name="PublicFiles" stopProcessing="true">
          <match url="public/.*" />
          <action type="None" />
        </rule>

        <!-- Cualquier archivo existente no se redirige a Node.js -->
        <rule name="StaticContent" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Todo lo demás va a server.js -->
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="data" />
          <add segment="datos" />
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".githooks" />
          <add segment="db" />
          <add segment="lib" />
          <add segment="middleware" />
          <add segment="routes" />
          <add segment="scripts" />
          <add segment="views" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>