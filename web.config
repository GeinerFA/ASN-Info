<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- La ruta va entre &quot; porque tiene espacios; sin ellas Windows intenta ejecutar "C:\Program" (HRESULT 0x2).
         Mientras se prueba el despliegue: loggingEnabled y devErrorsEnabled en true (logs en la carpeta iisnode\).
         El app pool necesita permiso de Modificar en iisnode\, data\ y public\uploads\; si iisnode no puede
         crear el log también responde 500.1002 / HRESULT 0x2. Cuando funcione, poner ambos en false.
         watchedFiles: reinicia node al copiar una versión nueva. -->
    <iisnode nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
             node_env="production"
             loggingEnabled="true"
             logDirectory="iisnode"
             devErrorsEnabled="true"
             watchedFiles="web.config;*.js" />

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- No interferir con las peticiones de depuración de iisnode -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js/_inspector" />
        </rule>

        <!-- Mapear el tráfico hacia el archivo server.js (Express sirve public/) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Que IIS no sirva directamente código, datos ni configuración -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="data" />
          <add segment="datos" />
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".githooks" />
          <add segment="db" />
          <add segment="lib" />
          <add segment="middleware" />
          <add segment="routes" />
          <add segment="scripts" />
          <add segment="views" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Control de errores detallados en el servidor -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
