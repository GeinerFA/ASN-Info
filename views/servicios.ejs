<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="contenido">
  <section class="encabezado-pagina">
    <div class="encabezado-pagina__caja oscuro">
      <div class="contenedor">
        <%- include('partials/migas', { migas: [{ nombre: 'Servicios', ruta: '/servicios' }] }) %>
        <p class="eyebrow" data-revelar>Servicios</p>
        <h1 data-palabras>Servicios de salud <span class="cursiva">disponibles</span></h1>
        <p class="encabezado-pagina__lead" data-revelar data-retardo="300">Conozca los servicios que ofrece el Área de Salud Naranjo y sus horarios. Para la mayoría de ellos necesita una cita o una referencia de su EBAIS.</p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--compacta" aria-label="Lista de servicios">
    <div class="contenedor">
      <div class="grid grid--3" data-revelar-grupo>
        <% servicios.forEach(function (s) { %><%- include('partials/tarjeta-servicio', { s: s }) %><% }) %>
      </div>
    </div>
  </section>

  <section class="cta-final" aria-labelledby="cta-titulo">
    <div class="cta-final__caja oscuro">
      <h2 id="cta-titulo" data-palabras>¿Tiene dudas sobre un <span class="cursiva">servicio</span>?</h2>
      <p data-revelar>Comuníquese directamente con el servicio que necesita.</p>
      <div class="hero__ctas" data-revelar>
        <a class="boton boton--claro boton--grande" href="/directorio"><%- textoBoton('Ver directorio telefónico') %><span class="boton__icono"><%- icono('arrow') %></span></a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
