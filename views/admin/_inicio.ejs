<!DOCTYPE html>
<html lang="es-CR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= titulo %> | Panel · <%= site.nombre %></title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/img/favicon-48.png" type="image/png" sizes="48x48">
  <link rel="icon" href="/img/favicon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin.js" defer></script>
</head>
<body class="admin">
<% if (locals.usuarioAdmin) { %>
<header class="admin-barra">
  <a class="admin-marca" href="/admin"><img class="admin-marca__logo" src="/img/logo-ccss-negro-128.png" srcset="/img/logo-ccss-negro-128.png 1x, /img/logo-ccss-negro-256.png 2x" alt="" width="40" height="40"> ASN</a>
  <nav aria-label="Panel">
    <a href="/admin"<% if (seccion === 'anuncios') { %> aria-current="page"<% } %>>Anuncios</a>
    <a href="/admin/directorio"<% if (seccion === 'directorio') { %> aria-current="page"<% } %>>Directorio</a>
    <a href="/admin/servicios"<% if (seccion === 'servicios') { %> aria-current="page"<% } %>>Servicios</a>
    <a href="/admin/contenido"<% if (seccion === 'contenido') { %> aria-current="page"<% } %>>Misión y visión</a>
    <a href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
  </nav>
  <form method="post" action="/admin/logout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="admin-salir" type="submit">Salir (<%= usuarioAdmin %>)</button>
  </form>
</header>
<% } %>
<main class="admin-main">
<% if (locals.flash) { %>
  <p class="aviso aviso--<%= flash.tipo %>" role="status"><%= flash.texto %></p>
<% } %>
