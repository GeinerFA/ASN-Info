<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="contenido">
  <section class="encabezado-pagina">
    <div class="encabezado-pagina__caja oscuro">
      <div class="contenedor">
        <%- include('partials/migas', { migas: [{ nombre: 'Directorio telefónico', ruta: '/directorio' }] }) %>
        <p class="eyebrow" data-revelar>Directorio · U.P. <%= site.unidadProgramatica %></p>
        <h1 data-palabras>Directorio <span class="cursiva">telefónico</span></h1>
        <p class="encabezado-pagina__lead" data-revelar data-retardo="300">Llame a la central del Área de Salud Naranjo y marque la opción del servicio que necesita. Ante una emergencia llame al <a href="tel:<%= site.emergencias %>"><strong><%= site.emergencias %></strong></a>.</p>
      </div>
    </div>
  </section>

  <section class="seccion seccion--compacta" aria-label="Menú telefónico">
    <div class="contenedor">
      <div class="ivr-central" data-revelar>
        <div class="ivr-central__numero">
          <span class="ivr-central__icono"><%- icono('phone') %></span>
          <div>
            <small>Central telefónica</small>
            <a href="tel:<%= telHref(site.telefono) %>"><%= site.telefono %></a>
          </div>
        </div>
        <ol class="ivr-central__pasos">
          <li><span><strong>Llame</strong> al <%= site.telefono %>.</span></li>
          <li><span><strong>Escuche</strong> el directorio interno.</span></li>
          <li><span><strong>Marque</strong> la opción del servicio o, si la conoce, la extensión.</span></li>
        </ol>
        <p class="ivr-central__correo">
          <%- icono('mail') %>
          <span><small><%= site.contraloria.nombre %> · quejas y sugerencias</small><a href="mailto:<%= site.contraloria.correo %>"><%= site.contraloria.correo %></a></span>
        </p>
      </div>

      <div class="buscador" hidden>
        <label for="buscar-directorio"><%- icono('search') %><span class="sr-only">Buscar en el directorio</span></label>
        <input id="buscar-directorio" type="search" placeholder="Buscar servicio, EBAIS o extensión…" autocomplete="off">
      </div>
      <p class="buscador__vacio" id="directorio-vacio" role="status" hidden>No se encontraron contactos con ese criterio.</p>

      <div class="ivr">
        <!-- Menú principal: en escritorio queda fijo a la izquierda mientras se recorren los submenús -->
        <div class="ivr__principal">
          <div class="ivr__menu ivr__menu--principal" data-grupo data-revelar>
            <header class="ivr__cabecera">
              <span class="ivr__tecla ivr__tecla--grande" aria-hidden="true"><%- icono('phone') %></span>
              <div>
                <small>Menú principal · <%= site.telefono %></small>
                <h2>Directorio interno</h2>
              </div>
            </header>
            <ul class="ivr__lista">
              <% menu.filter(function (m) { return !m.externo; }).forEach(function (m) { %>
                <li class="ivr__opcion<% if (m.hijos.length) { %> ivr__opcion--submenu<% } %>" data-fila>
                  <span class="ivr__tecla" aria-label="Opción <%= m.opcion %>"><%= m.opcion %></span>
                  <% if (m.hijos.length) { %>
                    <a class="ivr__nombre ivr__nombre--enlace" href="#submenu-<%= m.opcion %>"><%= m.nombre %><small class="ivr__ruta"><%= m.hijos.length %> opciones</small></a>
                    <span class="ivr__flecha" aria-hidden="true"><%- icono('arrow') %></span>
                  <% } else { %>
                    <span class="ivr__nombre"><%= m.nombre %></span>
                    <% if (m.extension) { %><span class="ivr__ext">Ext. <b><%= m.extension %></b></span><% } else { %><span></span><% } %>
                    <a class="ivr__llamar" href="tel:<%= marcar(m, m.ruta) %>"><%- icono('phone') %><span class="sr-only">Llamar a <%= m.nombre %></span></a>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="ivr__submenus" data-revelar-grupo>
          <!-- Submenús -->
          <% menu.filter(function (m) { return !m.externo && m.hijos.length; }).forEach(function (m) { %>
            <div class="ivr__menu" id="submenu-<%= m.opcion %>" data-grupo data-revelar>
              <header class="ivr__cabecera">
                <span class="ivr__tecla ivr__tecla--grande"><%= m.opcion %></span>
                <div>
                  <small>Marque <%= m.opcion %> en el menú principal</small>
                  <h2><%= m.nombre %></h2>
                </div>
              </header>
              <ul class="ivr__lista">
                <% m.hijos.forEach(function (h) { %>
                  <li class="ivr__opcion" data-fila>
                    <span class="ivr__tecla" aria-label="Opción <%= h.opcion %>"><%= h.opcion %></span>
                    <span class="ivr__nombre"><%= h.nombre %><small class="ivr__ruta">Marque <%= m.opcion %> y luego <%= h.opcion %></small></span>
                    <% if (h.extension) { %><span class="ivr__ext">Ext. <b><%= h.extension %></b></span><% } else { %><span></span><% } %>
                    <a class="ivr__llamar" href="tel:<%= marcar(h, [m.opcion, h.opcion]) %>"><%- icono('phone') %><span class="sr-only">Llamar a <%= h.nombre %></span></a>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>

          <!-- Ubicaciones externas (fuera del menú telefónico) -->
          <% menu.filter(function (m) { return m.externo && m.hijos.length; }).forEach(function (m) { %>
            <div class="ivr__menu ivr__menu--externo" id="externos-<%= m.id %>" data-grupo data-revelar>
              <header class="ivr__cabecera">
                <span class="ivr__tecla ivr__tecla--grande" aria-hidden="true"><%- icono('pin') %></span>
                <div>
                  <small>Fuera del menú telefónico · llame directamente</small>
                  <h2><%= m.nombre %></h2>
                </div>
              </header>
              <ul class="ivr__lista">
                <% m.hijos.forEach(function (h) { %>
                  <li class="ivr__opcion ivr__opcion--externa" data-fila>
                    <span class="ivr__tecla" aria-hidden="true"><%- icono('home') %></span>
                    <span class="ivr__nombre"><%= h.nombre %><% horariosVista(h.horario).forEach(function (linea) { %><small class="ivr__ruta"><%= linea %></small><% }) %></span>
                    <span class="ivr__ext"><b><%= h.telefono || site.telefono %></b><% if (h.extension) { %> · Ext. <b><%= h.extension %></b><% } %></span>
                    <a class="ivr__llamar" href="tel:<%= marcar(h, [], true) %>"><%- icono('phone') %><span class="sr-only">Llamar a <%= h.nombre %></span></a>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
