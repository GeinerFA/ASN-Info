<article class="tarjeta-servicio" data-revelar>
  <span class="tarjeta-servicio__icono"><%- icono(s.icono) %></span>
  <h3><%= s.nombre %></h3>
  <p><%= hora12(s.descripcion) %></p>
  <% horariosVista(s.horario).forEach(function (h) { %><p class="tarjeta-servicio__horario"><%- icono('clock') %><%= h %></p><% }) %>
</article>
